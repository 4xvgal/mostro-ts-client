{
  "name": "mostro-ts-client",
  "version": "0.2.0-rc.1",
  "description": "TypeScript client for the Mostro P2P Lightning-over-Nostr marketplace",
  "main": "./dist/protocol/index.js",
  "types": "./dist/protocol/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:node",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "test:node": "tsx --test test/*.test.ts test/node/*.test.ts",
    "test:bun": "bun test test/*.test.ts test/bun/*.test.ts",
    "test:browser": "tsx --test test/*.test.ts test/browser/*.test.ts",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "keywords": [
    "mostro",
    "nostr",
    "lightning",
    "bitcoin",
    "p2p",
    "nip44"
  ],
  "author": "4xvgal <4xvgal@protonmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "bip39": "^3.1.0",
    "hash-wasm": "^4.12.0",
    "nostr-tools": "^2.25.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/blessed": "^0.1.27",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "blessed": "^0.1.81",
    "fake-indexeddb": "^6.2.5",
    "react": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./node": {
      "types": "./dist/protocol/node-store.d.ts",
      "default": "./dist/protocol/node-store.js"
    },
    "./bun": {
      "types": "./dist/protocol/bun-store.d.ts",
      "default": "./dist/protocol/bun-store.js"
    },
    "./browser": {
      "types": "./dist/protocol/idb.d.ts",
      "default": "./dist/protocol/idb.js"
    },
    "./react": {
      "types": "./dist/react/hook.d.ts",
      "default": "./dist/react/hook.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4xvgal/mostro-ts-client.git"
  },
  "homepage": "https://github.com/4xvgal/mostro-ts-client#readme",
  "bugs": {
    "url": "https://github.com/4xvgal/mostro-ts-client/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "packageManager": "bun@1.3.14"
}
