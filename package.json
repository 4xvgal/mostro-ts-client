    "@scure/bip32": "^2.4.0",
    "@types/node": "^26.5.0",
    "better-sqlite3": "^13.0.3",
    "bip39": "^3.1.0",
    "nostr-tools": "^2.25.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/blessed": "^0.1.27",
